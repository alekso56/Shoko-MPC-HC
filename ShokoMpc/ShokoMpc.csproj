<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <Version>0.2.0</Version><AssemblyName>ShokoMpc</AssemblyName>
    <Title>Shoko MPC-HC</Title><Authors>Aleksander</Authors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.112" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Web/*" />
    <EmbeddedResource Include="Windows/Windows-Setup.zip" Condition="Exists('Windows/Windows-Setup.zip')" />
  </ItemGroup>
</Project>
